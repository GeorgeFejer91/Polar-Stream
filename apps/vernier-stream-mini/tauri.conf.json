{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vernier Stream Mini",
  "version": "0.6.0",
  "identifier": "dev.georgefejer.vernierstreammini",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Vernier Stream Mini",
        "width": 388,
        "height": 354,
        "minWidth": 330,
        "minHeight": 346,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    },
    "category": "DeveloperTool",
    "shortDescription": "Vernier Go Direct to LSL mini node",
    "longDescription": "A standalone lightweight Vernier Go Direct mini node that publishes metadata-exposed raw channels and the derived breathing stream to LSL.",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
